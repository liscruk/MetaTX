#!/usr/bin/env python

import os
import sys
import re

RESULTS = config["results"]
SAMPLES = config["samples"]
SPECIES = config["species"]
REFNAME = SPECIES[0]+"."+SPECIES[1]
MODE = config.get("mode", "canonical").lower()

if MODE not in ("canonical", "novel", "both"):
	sys.exit("Unknown mode '" + MODE + "'. Use Canonical, Novel or Both.")

# Get reference of human (if human is involved)
refHuman = config["hg38Seq"]
anHuman = config["hg38Gtf"]
txHuman = config["hg38Tx"]

# Get reference of Xeno or Meta organism
refXeno = config["XenoSeq"]
anXeno = config["XenoGtf"]
txXeno = config["XenoTx"]


# {sample} may only match sample names from the config
wildcard_constraints:
	sample = "|".join(re.escape(s) for s in SAMPLES)

# Each branch defines its own target list (CANONICAL_TARGETS / NOVEL_TARGETS)
output = list()

if MODE in ("canonical", "both"):
	include: "rules/canonical.smk"
	output += CANONICAL_TARGETS

if MODE in ("novel", "both"):
	include: "rules/novel.smk"
	output += NOVEL_TARGETS

# Species composition (reads per species + ratio) for whichever branches run
include: "rules/species.smk"
output += SPECIES_TARGETS


# Prep output with rule all
rule all:
	default_target: True
	input:
		output

### Builds the hybrid references used by both branches.
### Inputs may be plain or gzipped. Genome contigs and GTF seqnames are prefixed with the
### species tag (e.g. hs_chr1, mm_chr1) because GENCODE human and mouse share contig names.
### Transcript IDs are left untouched (they are already species-specific).
rule makeRef:
	input:
		# Host reference fasta
		hr = refHuman,
		# Host reference annotation gtf
		ha = anHuman,
		# Host reference transcriptome fasta
		hx = txHuman,
		# Xeno or pathogen genome fasta
		xr = refXeno,
		# Xeno or pathogen gtf NOT gff3
		xa = anXeno,
		# Xeno or pathogen transcripts fasta
		xx = txXeno
	output:
		rHyb = RESULTS + "refs/Hybrid_genome." + REFNAME + ".fa",
		rFai = RESULTS + "refs/Hybrid_genome." + REFNAME + ".fa.fai",
		anHyb = RESULTS + "refs/Hybrid_annotation." + REFNAME + ".gtf",
		txHyb = RESULTS + "refs/Hybrd_transcriptome." + REFNAME + ".fa"
	params:
		hs = SPECIES[0],
		xs = SPECIES[1]
	conda:
		"envs/mapping.yaml"
	shell:"""
		dc() {{ case "$1" in *.gz) gzip -dc "$1" ;; *) cat "$1" ;; esac; }}
		pfa() {{ awk -v p="$1_" '/^>/{{sub(/^>/, ">" p)}} 1'; }}
		pgtf() {{ awk -v p="$1_" 'BEGIN{{FS=OFS="\t"}} !/^#/{{$1 = p $1; print}}'; }}

		{{ dc {input.hr} | pfa {params.hs}; dc {input.xr} | pfa {params.xs}; }} > {output.rHyb}
		samtools faidx {output.rHyb}

		{{ dc {input.hx}; dc {input.xx}; }} > {output.txHyb}

		{{ dc {input.ha} | pgtf {params.hs}; dc {input.xa} | pgtf {params.xs}; }} > {output.anHyb}
	"""
